---
import type { CollectionEntry } from 'astro:content';
import Tags from './Tags.astro';
const {posts}=Astro.props as {posts:CollectionEntry<'writing'>[]};
---
<div class="post-list">{posts.map(post=><article class="post"><a class="post-link" href={`/learnings/${post.id}/`}><h3>{post.data.title}</h3></a><Tags tags={post.data.tags}/></article>)}</div>
