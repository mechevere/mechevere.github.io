---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tags from '../../components/Tags.astro';
export async function getStaticPaths(){const preview=import.meta.env.DEV||import.meta.env.INCLUDE_DRAFTS==='true';const posts=await getCollection('writing',({data})=>preview||!data.draft);return posts.map(post=>({params:{id:post.id},props:{post}}));}
const {post}=Astro.props;
const {Content}=await render(post);
---
<Base title={post.data.title} description={post.data.description} active="learnings" article><article class="article"><a class="text-link back" href="/learnings/">← Learnings</a><h1>{post.data.title}</h1><div class="prose"><Content/></div><Tags tags={post.data.tags}/><div class="article-end"><a class="text-link" href="/learnings/">Back to Learnings</a></div></article></Base>
