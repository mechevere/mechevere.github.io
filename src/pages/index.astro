---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';
const showDrafts=import.meta.env.DEV||import.meta.env.INCLUDE_DRAFTS==='true';
const posts=(await getCollection('writing',({data})=>showDrafts||!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Base><section class="hero"><h1>Mateo’s site</h1><p class="intro">Hi, I’m Mateo. This is where I share things I’m learning, building, and trying to understand. You’ll find notes on whatever has caught my attention, projects I’m working on, and things I’ve enjoyed reading.</p><a class="text-link" href="/about/">More about me</a></section><section class="home-section"><div class="section-heading"><h2><a href="/learnings/">Learnings</a></h2><a class="text-link" href="/learnings/">View all →</a></div>{posts.length?<PostList posts={posts.slice(0,3)}/>:<p class="empty-state">First essays are on their way.</p>}</section><section class="home-section"><h2><a href="/reading-list/">Reading List</a></h2><p class="section-description">Books, articles, and other things worth keeping.</p><a class="text-link" href="/reading-list/">Browse the list</a></section></Base>
